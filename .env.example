# ===== 百度云 VAT OCR 凭证 =====
# 申请地址：https://cloud.baidu.com/product/ocr/invoice （增值税发票识别）
# 创建应用后获取 API Key 与 Secret Key
BAIDU_OCR_API_KEY=your_baidu_api_key
BAIDU_OCR_SECRET_KEY=your_baidu_secret_key

# ===== 管理员账号（后台台账管理需登录）=====
# 必填；未设置时后台和识别功能均不可登录
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# ===== Flask 会话密钥 =====
# 留空则每次启动随机生成；生产环境建议固定一个强随机值
FLASK_SECRET_KEY=

# HTTPS 部署时设为 1，使会话 Cookie 仅通过 HTTPS 发送
SESSION_COOKIE_SECURE=0

# 单个来源 IP 每分钟最多调用 OCR 次数，避免付费接口被滥用
OCR_RATE_LIMIT_PER_MINUTE=10
