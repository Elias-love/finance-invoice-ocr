# ===== 百度云 VAT OCR 凭证 =====
# 申请地址：https://cloud.baidu.com/product/ocr/invoice （增值税发票识别）
# 创建应用后获取 API Key 与 Secret Key
BAIDU_OCR_API_KEY=your_baidu_api_key
BAIDU_OCR_SECRET_KEY=your_baidu_secret_key

# auto：系统代理失败后直连兜底；direct：始终直连；system：始终沿用系统代理
BAIDU_OCR_PROXY_MODE=auto

# ===== 管理员账号（后台台账管理需登录）=====
# 必填；未设置时后台和识别功能均不可登录
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# 可选独立复核账号；生产环境建议配置并启用经办/复核分离
REVIEWER_USERNAME=reviewer
REVIEWER_PASSWORD=
ENFORCE_MAKER_CHECKER=0

# ===== Flask 会话密钥 =====
# 留空则每次启动随机生成；生产环境建议固定一个强随机值
FLASK_SECRET_KEY=

# 生产环境可将台账放到受备份和访问控制保护的路径
DB_PATH=

# HTTPS 部署时设为 1，使会话 Cookie 仅通过 HTTPS 发送
SESSION_COOKIE_SECURE=0

# 单个来源 IP 每分钟最多调用的 OCR 页数，避免多页 PDF 绕过成本控制
OCR_RATE_LIMIT_PER_MINUTE=60

# 单个 PDF 最大页数
MAX_PDF_PAGES=30
MAX_RENDER_PIXELS=40000000

# PDF 默认按约 180 DPI 渲染；小字号或压缩扫描件可提高至 3.0
PDF_ZOOM=2.5

# 图像质量门禁（需结合本单位样本标定）
IMAGE_MIN_SHORT_EDGE_HARD=700
IMAGE_MIN_SHORT_EDGE_WARN=1200
IMAGE_BLUR_HARD=25
IMAGE_BLUR_WARN=65
IMAGE_BRIGHTNESS_MIN=45
IMAGE_BRIGHTNESS_MAX=252
IMAGE_CONTRAST_MIN=28

# ===== 机器预审与人工复核策略 =====
# 1：硬性校验全部通过的小额发票进入“机器预审通过”；0：全部进入人工队列
AUTO_PASS_ENABLED=1

# 价税合计达到该金额时强制人工复核
HIGH_VALUE_REVIEW_AMOUNT=100000

# 对机器预审通过记录做确定性抽样质检（0.05 = 5%）
REVIEW_SAMPLE_RATE=0.05

# 1：允许“机器预审通过”记录直接导出；0：必须人工批准后才可导出
ALLOW_AUTO_PASS_EXPORT=1

# 1：二维码无法与 OCR 交叉验证时不得自动通过
REQUIRE_QR_FOR_AUTO_PASS=1

# 票头/明细/大写金额勾稽允许的最大差额
RECONCILIATION_TOLERANCE=0.01

# 可选购买方主数据白名单，多个值用英文逗号分隔；配置后不匹配会强制复核
EXPECTED_PURCHASER_TAX_IDS=
EXPECTED_PURCHASER_NAMES=

# 默认禁止网页清空审计台账；只允许本地演示环境临时开启
ALLOW_DESTRUCTIVE_CLEAR=0
